# Front door: `./cli/symcourse new …` → scripts/makecourse/makecourse.sh
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MAKECOURSE="$ROOT/scripts/makecourse/makecourse.sh"

usage() {
  cat <<'EOF'
Usage:
  symcourse new <course-name> [outdir] --course-number TEXT --course-title TEXT [options]
  symcourse help

Scaffold a course repository (layout, runtime, identity). Then, if
symkit is on PATH, install the teaching instructor pack and docs/slos.md.
Do not pass --scaffold to that nested install.

Required:
  --course-number TEXT   Catalog / display code (alias: --code)
  --course-title TEXT    Human title (alias: --title)

Options:
  --with-pages           GitHub Pages hub (site/ + workflow)
  --no-agents            Skip nested `symkit install`
  --adapters SET         Passed to nested symkit (grok, claude, codex, all, none)
  -h, --help             Show this help

Existing files in the target are left alone. Requires python3; uv writes
uv.lock when present. Nested symkit is optional.
EOF
}

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
  new)
    shift
    exec "$MAKECOURSE" "$@"
    ;;
  *)
    printf 'error: unknown command: %s (try: new)\n\n' "$cmd" >&2
    usage >&2
    exit 1
    ;;
esac
