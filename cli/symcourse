# Build and exec the Rust binary. Inside this checkout the binary reads
# catalog.yaml and templates/ from the tree (see src/assets.rs).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/target/debug/symcourse"
if [[ ! -x "$BIN" ]]; then
  cargo build --manifest-path "$ROOT/Cargo.toml" --quiet
fi
exec "$BIN" "$@"
